           <picture>
            <source media="(max-width: 768px)" srcset="/documents/d/hogar/banner1295x200px" width="782">
            <img src="/documents/d/hogar/banner1295x200px" width="1920" alt="Banner Promocional Telmex" fetchpriority="high" class="responsive-banner" style="aspect-ratio: 2591 / 401;"> 
