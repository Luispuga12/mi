         <script>
    (function () {
        let metaDescription = document.querySelector('meta[name="description"]');
        if (!metaDescription) {
            metaDescription = document.createElement('meta');
            metaDescription.name = "description";
            metaDescription.content = "Contrata tu Paquete Infinitum con la mejor velocidad, entretenimiento y más. Descubre las mejores ofertas para tu hogar con Telmex.";
            document.head.appendChild(metaDescription);
        } else if (!metaDescription.content) {
            metaDescription.content = "Contrata tu Paquete Infinitum con la mejor velocidad, entretenimiento y más. Descubre las mejores ofertas para tu hogar con Telmex.";
        }
    })();

    document.addEventListener("DOMContentLoaded", function () {
        const menuBtn = document.querySelector('.nv-mobile-menu-btn');
        const drawer = document.getElementById('nv-mobile-drawer');
        const overlay = document.getElementById('nv-drawer-overlay');
        const closeBtn = document.getElementById('nv-drawer-close');

        function openDrawer() {
            drawer.classList.add('open');
            overlay.classList.add('open');
        }

        function closeDrawer() {
            drawer.classList.remove('open');
            overlay.classList.remove('open');
        }

        if (menuBtn) {
            menuBtn.addEventListener('click', openDrawer);
        }
        if (closeBtn) {
            closeBtn.addEventListener('click', closeDrawer);
        }
        if (overlay) {
            overlay.addEventListener('click', closeDrawer);
        }
				
				
				// Font size controls
        var plusBtn = document.getElementById('plusTypo');
        var minusBtn = document.getElementById('minusTypo');
        if (plusBtn) {
            plusBtn.addEventListener('click', function () {
                var fontSize = parseInt(window.getComputedStyle(document.body).fontSize);
                if (fontSize < 19) {
                    document.body.style.fontSize = (fontSize + 1) + 'px';
                    dataLayer.push({ 'event': 'addevent', 'macro-page': 'Menu Top', 'event-value': 'Font Plus' });
                }
            });
        }
        if (minusBtn) {
            minusBtn.addEventListener('click', function () {
                var fontSize = parseInt(window.getComputedStyle(document.body).fontSize);
                if (fontSize > 10) {
                    document.body.style.fontSize = (fontSize - 1) + 'px';
                    dataLayer.push({ 'event': 'addevent', 'macro-page': 'Menu Top', 'event-value': 'Font Minus' });
                }
            });
        }

        const greetingDesktop = document.querySelector('.nv-user-greeting');
        const greetingMobile = document.querySelector('.nv-user-greeting-mobile');

        if (cookieValida('nam')) {
            let nombre = getCookie('nam');
            nombre = encok(nombre, 'd');

            // Format name (capitalize first letter of each word)
            nombre = nombre.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');

            // Desktop
            const userNameEl = document.getElementById('nv-user-name');
            if (userNameEl) {
                userNameEl.textContent = nombre;
            }

            // Mobile
            const userNameMobileEl = document.getElementById('nv-user-name-mobile');
            if (userNameMobileEl) {
                userNameMobileEl.textContent = nombre;
            }
        } else {
            if (greetingDesktop) greetingDesktop.innerHTML = 'Mi cuenta <span id="nv-user-name"></span>';
            if (greetingMobile) greetingMobile.innerHTML = 'Mi cuenta <span id="nv-user-name-mobile"></span>';

            const logoutDesktop = document.querySelector('.nv-logout');
            if (logoutDesktop) logoutDesktop.style.display = 'none';

            const logoutMobile = document.querySelector('.nv-logout-mobile');
            if (logoutMobile) logoutMobile.style.display = 'none';
        }

        const userToggle = document.getElementById('nv-user-toggle');
        const userWidget = document.getElementById('nv-user-widget');
        if (userToggle && userWidget) {
            userToggle.addEventListener('click', (e) => {
                e.stopPropagation();
                userWidget.classList.toggle('open');
            });
            document.addEventListener('click', (e) => {
                if (!userWidget.contains(e.target)) {
                    userWidget.classList.remove('open');
                }
            });
        }

        const userToggleMobile = document.getElementById('nv-user-toggle-mobile');
        const userWidgetMobile = document.getElementById('nv-user-widget-mobile');
        if (userToggleMobile && userWidgetMobile) {
            userToggleMobile.addEventListener('click', (e) => {
                e.stopPropagation();
                userWidgetMobile.classList.toggle('open');
            });
        }
    });



    // Mega Menu Desktop Click Logic
    const megaParents = document.querySelectorAll('.nv-mega-parent');
    megaParents.forEach(megaParent => {
        const megaToggle = megaParent.querySelector('.nv-mega-toggle');
        if (megaToggle) {
            megaToggle.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();

                // Close others
                megaParents.forEach(p => {
                    if (p !== megaParent) p.classList.remove('open');
                });

                megaParent.classList.toggle('open');
            });
        }
    });

    document.addEventListener('click', (e) => {
        megaParents.forEach(megaParent => {
            if (!megaParent.contains(e.target)) {
                megaParent.classList.remove('open');
            }
        });
    });

    // For each mega parent, set its first category to active
    megaParents.forEach(megaParent => {
        const megaCategories = megaParent.querySelectorAll('.nv-mega-category');
        const categoriesContainer = megaParent.querySelector('.nv-mega-categories');

        function updateHeight(activeCat) {
            const panel = activeCat.querySelector('.nv-mega-panel');
            if (panel && categoriesContainer) {
                const panelHeight = panel.scrollHeight;
                const baseHeight = megaCategories.length * 52 + 30; // base height for sidebar items
                categoriesContainer.style.minHeight = Math.max(panelHeight, baseHeight) + 'px';
            }
        }

        if (megaCategories.length > 0) {
            megaCategories[0].classList.add('active');
            
            megaCategories.forEach(cat => {
                const link = cat.querySelector('a');
                if (link) {
                    link.addEventListener('click', (e) => {
                        e.preventDefault();
                        megaCategories.forEach(c => c.classList.remove('active'));
                        cat.classList.add('active');
                        updateHeight(cat);
                    });
                }
            });
        }

        // Update height when the dropdown is toggled
        const toggle = megaParent.querySelector('.nv-mega-toggle');
        if (toggle) {
            toggle.addEventListener('click', () => {
                if (megaParent.classList.contains('open')) {
                    setTimeout(() => {
                        const activeCat = megaParent.querySelector('.nv-mega-category.active');
                        if (activeCat) updateHeight(activeCat);
                    }, 10);
                }
            });
        }
    });

    // Mega Menu Mobile Accordion Logic
    const mobileParentToggles = document.querySelectorAll('.nv-mobile-parent-toggle');
    mobileParentToggles.forEach(toggle => {
        toggle.addEventListener('click', (e) => {
            e.preventDefault();
            const wrapper = toggle.parentElement;

            // Optional: close other main accordions
            const siblings = document.querySelectorAll('.nv-mobile-accordion-wrapper');
            siblings.forEach(sib => {
                if (sib !== wrapper) sib.classList.remove('open');
            });

            wrapper.classList.toggle('open');
        });
    });

    const subAccordionHeaders = document.querySelectorAll('.nv-mobile-sub-accordion-header');
    subAccordionHeaders.forEach(header => {
        header.addEventListener('click', (e) => {
            e.preventDefault();
            const parent = header.parentElement;

            // Optional: close other accordions
            const siblings = parent.parentElement.querySelectorAll('.nv-mobile-sub-accordion');
            siblings.forEach(sib => {
                if (sib !== parent) sib.classList.remove('open');
            });

            parent.classList.toggle('open');
        });
    });


    function encok(nam, ac) {
        var tmxUT = {
            _keyStr: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=",
            tmxUTE: function (input) {
                var output = ""; var chr1, chr2, chr3, enc1, enc2, enc3, enc4; var i = 0; input = tmxUT._utf8_encode(input); while (i < input.length) { chr1 = input.charCodeAt(i++); chr2 = input.charCodeAt(i++); chr3 = input.charCodeAt(i++); enc1 = chr1 >> 2; enc2 = (chr1 & 3) << 4 | chr2 >> 4; enc3 = (chr2 & 15) << 2 | chr3 >> 6; enc4 = chr3 & 63; if (isNaN(chr2)) enc3 = enc4 = 64; else if (isNaN(chr3)) enc4 = 64; output = output + this._keyStr.charAt(enc1) + this._keyStr.charAt(enc2) + this._keyStr.charAt(enc3) + this._keyStr.charAt(enc4) } return output
            },
            tmxUTD: function (input) {
                var output = ""; var chr1, chr2, chr3; var enc1, enc2, enc3, enc4; var i = 0; input = input.replace(/[^A-Za-z0-9\+\/\=]/g, ""); while (i < input.length) { enc1 = this._keyStr.indexOf(input.charAt(i++)); enc2 = this._keyStr.indexOf(input.charAt(i++)); enc3 = this._keyStr.indexOf(input.charAt(i++)); enc4 = this._keyStr.indexOf(input.charAt(i++)); chr1 = enc1 << 2 | enc2 >> 4; chr2 = (enc2 & 15) << 4 | enc3 >> 2; chr3 = (enc3 & 3) << 6 | enc4; output = output + String.fromCharCode(chr1); if (enc3 != 64) output = output + String.fromCharCode(chr2); if (enc4 != 64) output = output + String.fromCharCode(chr3) } output = tmxUT._utf8_decode(output); return output
            },
            _utf8_encode: function (string) {
                string = string.replace(/\r\n/g, "\n"); var utftext = ""; for (var n = 0; n < string.length; n++) { var c = string.charCodeAt(n); if (c < 128) utftext += String.fromCharCode(c); else if (c > 127 && c < 2048) { utftext += String.fromCharCode(c >> 6 | 192); utftext += String.fromCharCode(c & 63 | 128) } else { utftext += String.fromCharCode(c >> 12 | 224); utftext += String.fromCharCode(c >> 6 & 63 | 128); utftext += String.fromCharCode(c & 63 | 128) } } return utftext
            },
            _utf8_decode: function (utftext) {
                var string = ""; var i = 0; var c = c1 = c2 = 0; while (i < utftext.length) { c = utftext.charCodeAt(i); if (c < 128) { string += String.fromCharCode(c); i++ } else if (c > 191 && c < 224) { c2 = utftext.charCodeAt(i + 1); string += String.fromCharCode((c & 31) << 6 | c2 & 63); i += 2 } else { c2 = utftext.charCodeAt(i + 1); c3 = utftext.charCodeAt(i + 2); string += String.fromCharCode((c & 15) << 12 | (c2 & 63) << 6 | c3 & 63); i += 3 } } return string
            }
        };
        switch (ac) {
            case "d": nam = tmxUT.tmxUTD(nam); break;
            case "e": nam = tmxUT.tmxUTE(nam); break;
        }
        return nam;
    }

    function getCookie(c_name) {
        if (document.cookie.length > 0) {
            let c_start = document.cookie.indexOf(c_name + "=");
            if (c_start != -1) {
                c_start = c_start + c_name.length + 1;
                let c_end = document.cookie.indexOf(";", c_start);
                if (c_end == -1) c_end = document.cookie.length;
                return unescape(document.cookie.substring(c_start, c_end));
            }
        }
        return null;
    }

    function cookieValida(nomCookie) {
        var exist = getCookie(nomCookie);
        if (exist == null || exist == "null") return false;
        else return true;
    }
</script>
        </div>
       </div>
      </div>
     </div>
    </div>
   </section>
  </div>
 </div>
