            function cargarImagenClaroVideo() {
                if (imagenesCvCargadas) return;
                imagenesCvCargadas = true;

                eventosImagenesCv.forEach(evento => {
                    window.removeEventListener(evento, cargarImagenClaroVideo, { passive: true });
                });

                document.querySelectorAll('.cv-img-container').forEach(contenedor => {
                    const skeleton = contenedor.querySelector('.img-skeleton');
                    if (skeleton) skeleton.remove();

                    const img = document.createElement('img');
                    img.src = '/documents/d/hogar/cu_v_i00-2';
                    img.alt = 'Claro Video Universal';
                    img.onerror = function() { this.style.display = 'none'; };

                    contenedor.appendChild(img);
                });
            }

            eventosImagenesCv.forEach(evento => {
                window.addEventListener(evento, cargarImagenClaroVideo, { passive: true });
            });

