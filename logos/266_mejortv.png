           <script>
            function toggleCtaButtons() {
                const container = document.getElementById('cta-buttons-container');
                const icon = document.getElementById('cta-chevron-icon');

                if (container.classList.contains('collapsed')) {
                    container.classList.remove('collapsed');
                    icon.style.transform = 'rotate(0deg)'; // Expanded -> Down
                } else {
                    container.classList.add('collapsed');
                    icon.style.transform = 'rotate(180deg)'; // Collapsed -> Up
                }
            }

            // Ensure desktop is not collapsed initially or handles resize properly
            window.addEventListener('resize', () => {
                if (window.innerWidth > 768) {
                    document.getElementById('cta-buttons-container').classList.remove('collapsed');
                }
            });
            // Trigger on load
            if (window.innerWidth > 768) {
                document.getElementById('cta-buttons-container').classList.remove('collapsed');
            }
        </script>
