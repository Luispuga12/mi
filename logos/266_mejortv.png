           <script>
            function abrirModalDomi() {
                const overlay = document.getElementById('modalTecDomi');
                if (overlay) {
                    overlay.classList.remove('ln-overlay--hidden');
                    overlay.classList.add('ln-overlay--visible');
                }

                document.getElementById('modalTecDomiStep0').style.display = 'none';
                document.getElementById('modalTecDomiStep2').style.display = 'none';
                document.getElementById('modalTecDomiStep1').style.display = 'block';
            }

            function cerrarModalTecDomi() {
                const overlay = document.getElementById('modalTecDomi');
                if (!overlay) return;

                overlay.classList.remove('ln-overlay--visible');
                overlay.classList.add('ln-overlay--hidden');

                setTimeout(() => {
                    document.getElementById('modalTecDomiStep1').style.display = 'none';
                    document.getElementById('modalTecDomiStep2').style.display = 'none';
                    document.getElementById('modalTecDomiStep0').style.display = 'none';

                    document.getElementById('td-nombre').value = '';
                    document.getElementById('td-cel').value = '';
                    document.getElementById('td-cp').value = '';
                    document.getElementById('td-email').value = '';

                    document.getElementById('err-td-nombre').style.display = 'none';
                    document.getElementById('err-td-cel').style.display = 'none';
                    document.getElementById('err-td-cp').style.display = 'none';
                    document.getElementById('err-td-email').style.display = 'none';

                    const btn = document.getElementById('btn-domi-modal');
                    if (btn) btn.disabled = false;
                }, 350);
            }

            function validateEmail(email) {
                const regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                return regex.test(email);
            }

            /* ── Validación y envío del formulario #modalTecDomi ── */
            function validateFormDomi() {
                let valido = true;

                // --- Nombre completo: mínimo 2 palabras de mínimo 3 chars cada una ---
                const nombreEl = document.getElementById('td-nombre');
                let nombre = nombreEl.value.trim();
                let palabras = nombre.split(/\s+/).filter(function (p) { return p.length >= 3; });
                if (palabras.length < 2) {
                    document.getElementById('err-td-nombre').style.display = 'block';
                    valido = false;
                } else {
                    document.getElementById('err-td-nombre').style.display = 'none';
                }

                const emailEl = document.getElementById('td-email');
                let email = emailEl.value.trim();
                if (!validateEmail(email)) {
                    document.getElementById('err-td-email').style.display = 'block';
                    valido = false;
                } else {
                    document.getElementById('err-td-email').style.display = 'none';
                }

                // --- Celular: entero positivo de exactamente 10 dígitos ---
                const celEl = document.getElementById('td-cel');
                let cel = celEl.value.replace(/\D/g, '');
                if (!/^[1-9]\d{9}$/.test(cel)) {
                    document.getElementById('err-td-cel').style.display = 'block';
                    valido = false;
                } else {
                    document.getElementById('err-td-cel').style.display = 'none';
                }

                // --- Código Postal: entero positivo de exactamente 5 dígitos ---
                const cpEl = document.getElementById('td-cp');
                let cp = cpEl.value.replace(/\D/g, '');
                if (!/^\d{5}$/.test(cp)) {
                    document.getElementById('err-td-cp').style.display = 'block';
                    valido = false;
                } else {
                    document.getElementById('err-td-cp').style.display = 'none';
                }

                return valido;
            }

            async function sendRetargetingCorreo() {
                const url = "/web/contrata/portlet-login-ip?p_p_id=com_telmex_idobauth_IdobauthPortlet&p_p_lifecycle=2&p_p_state=normal&p_p_mode=view&p_p_resource_id=%2Fidobauth%2FresourceURL&p_p_cacheability=cacheLevelPage&servicio=msm";
                const celular = document.getElementById('td-cel').value;
                const data = {
                    "celular": celular,
                    "idSolicitud": "MzY1MTo3ODow",
                    "datosEnvio": [
                        {
                            "campo": "telefono",
                            "valor": celular
                        }
                    ]
                };

                const formData = new URLSearchParams();
                formData.append("data", JSON.stringify({
                    "strvar": window.aesUtil ? window.aesUtil.encrypt(JSON.stringify(data)) : JSON.stringify(data)
                }));

                try {
                    const responseRaw = await fetch(url, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                            'Accept': 'application/json, text/javascript, */*; q=0.01',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: formData
                    });

                    if (!responseRaw.ok) throw new Error("Error en la respuesta del servidor");

                    let response = await responseRaw.json();

                    if (response == null || response.codigo != "00") {
                        return;
                    }
                } catch (error) {
                }
            }

            document.addEventListener('click', async function (e) {
                // Overlay click to close
                if (e.target.id === 'modalTecDomi') {
                    cerrarModalTecDomi();
                    return;
                }

                const btnDomi = e.target.closest('#btn-domi-modal');
                if (btnDomi) {
                    e.preventDefault();
                    if (!validateFormDomi()) return;

                    btnDomi.disabled = true;

                    sendRetargetingCorreo();

                    try {
                        const nombre = document.getElementById('td-nombre').value || "NA";
                        const cel = document.getElementById('td-cel').value || "NA";
                        const email = document.getElementById('td-email').value || "NA";
                        const cp = document.getElementById('td-cp').value || "NA";

                        let valoresP = {
                            "servicio_tipo_id": "NA",
                            "servicio_id": "NA",
                            "nombre": nombre,
                            "nombre_paterno": "NA",
                            "nombre_materno": "NA",
                            "tel": "",
                            "telefonocontacto": cel,
                            "telinternacional": "NA",
                            "email": email,
                            "rfc": "NA",
                            "dir_calle_tipo_id": "NA",
                            "dir_calle": "NA",
                            "dir_num_ext": "NA",
                            "dir_num_int": "NA",
                            "os": "",
                            "claveservicio": "",
                            "dir_entre_calle_01": "NA",
                            "dir_entre_calle_02": "NA",
                            "dir_colonia": "NA",
                            "dir_municipio": "NA",
                            "dir_cp": cp,
                            "dir_estado_id": "NA",
                            "modem_entrega_id": "NA",
                            "recibo_papel_no": "N",
                            "domicilio_mapa_coord": "NA,NA",
                            "diradicional": "",
                            "plazo": "",
                            "idtipo": "",
                            "identifica": "",
                            "tel_cel": cel,
                            "flbranch": "F003",
                            "fechaagenda": "",
                            "fauth": "NO",
                            "horario_contacto": "NA",
                            "telefono_asignado": "",
                            "mwresponse": "",
                            "condicion_aceptar_id": "NA",
                            "datos_recoleccion": (sessionStorage.getItem('_dataTrack') && window.aesUtil) ? window.aesUtil.decrypt(sessionStorage.getItem('_dataTrack')) : 'Sin SS',
                            "tipo_cliente": window.location.pathname.includes("negocios") ? "NEG" : "RES",
                            "tipo_proceso": 'NO DOMICILIADOS',
                            "error": '',
                            "descerror": '',
                            "errorAlta": "NA",
                            "cava": "{}"
                        };

                        const peticion = await fetch("https://apcomercial.telmex.com/dev/tomapedido/lineas_nuevas_retargeting.php?callToFunction=solicitudIncompleta", {
                            method: "POST",
                            headers: {
                                "content-type": "application/json"
                            },
                            body: JSON.stringify(valoresP)
                        });
                        const resp = await peticion.text();
                    } catch (error) {
                        console.log(error);
                        btnDomi.disabled = false;
                    }

                    document.getElementById('modalTecDomiStep1').style.display = 'none';
                    document.getElementById('modalTecDomiStep2').style.display = 'block';
                }

                const btnAceptar = e.target.closest('#btn-domi-aceptar');
                if (btnAceptar) {
                    e.preventDefault();
                    cerrarModalTecDomi();
                }
            });

            // Limpiar errores al escribir en cada campo
            document.addEventListener('input', function (e) {
                if (e.target.id === 'td-nombre') {
                    if (document.getElementById('err-td-nombre').style.display !== 'none') validateFormDomi();
                } else if (e.target.id === 'td-cel') {
                    if (document.getElementById('err-td-cel').style.display !== 'none') validateFormDomi();
                } else if (e.target.id === 'td-cp') {
                    if (document.getElementById('err-td-cp').style.display !== 'none') validateFormDomi();
                } else if (e.target.id === 'td-email') {
                    if (document.getElementById('err-td-email').style.display !== 'none') validateFormDomi();
                }
            });
        </script>
           <div class="container" style="font-size: 0.8em; line-height: 18px; color: black;">
            <div class="leg_paq activo" style="">
             <div id="bloqTyC" style="display: flex; align-items: baseline; min-width: 0;">
              <p style="text-align: left; font-size: 0.8em;" id="termYcondiHome" class="termYcondiHome">Precios con impuestos incluidos. Las velocidades comunicadas son en Megas (Megabits por segundo) y corresponden a la velocidad máxima de transferencia de datos ofrecida y alcanzable, la velocidad de bajada y subida podrá variar en función de las condiciones técnicas del módem, cantidad de dispositivos conectados simultáneamente y/o la distancia entre el domicilio del usuario y la central. La velocidad aplica para usuarios activos sin adeudos en sus servicios de telecomunicaciones y nuevos que cuentan con fibra óptica instalada. Todos los derechos reservados. Claro Video es un servicio proporcionado por un tercero. Plazos, términos, condiciones, inscripciones CRT y velocidades promedio de descarga aplicables, disponibles en: <a href="http://telmex.com/terminoshogar" aria-label="telmex.com/terminoshogar">telmex.com/terminoshogar</a>&nbsp; <strong>Vigencia 31 de octubre de 2026.</strong><button id="btnVerMenos" class="btnVer" style="display:none;">Ver menos</button></p> <button id="btnVerMas" class="btnVer">Ver más</button>
             </div>
             <style>
                    .termYcondiHome {
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                        min-width: 0;
                    }


                    .btnVer {
                        background: none;
                        border: none;
                        padding: 0;
                        margin-left: 4px;
                        font-family: inherit;
                        font-size: inherit;
                        color: #737373;
                        text-decoration: underline;
                        cursor: pointer;
                        flex-shrink: 0;
                        white-space: nowrap;
                    }

                </style>
            </div>
            <script>
                const btnMas   = document.getElementById("btnVerMas");
                const btnMenos = document.getElementById("btnVerMenos");
                const texTermCondi = document.getElementById("termYcondiHome");

                // Expandir
                btnMas.addEventListener("click", function(){
                    texTermCondi.classList.remove("termYcondiHome");
                    btnMas.style.display   = "none";
                    btnMenos.style.display = "inline";
                });

                // Colapsar
                btnMenos.addEventListener("click", function(){
                    texTermCondi.classList.add("termYcondiHome");
                    btnMas.style.display   = "";
                    btnMenos.style.display = "none";
                });
            </script>
