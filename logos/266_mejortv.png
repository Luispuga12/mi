	<title>Internet Infinitum y teléfono con llamadas ilimitadas para tu casa - Hogar - Telmex</title>
	<meta content="initial-scale=1.0, width=device-width" name="viewport" />

		<link rel="preload" href="/o/tema-contrata-nuevo/css/main.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
		<noscript><link rel="stylesheet" href="/o/tema-contrata-nuevo/css/main.css" /></noscript>
		<style>
			.autofit-float {
				display: none !important;
			}
		</style>

	<link rel="preconnect" href="https://telmex.com" crossorigin="anonymous" />
	<style>
		body {
			margin: 0;
			padding: 0;
			font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", "Noto Sans", "Liberation Sans", Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
			font-size: 1rem;
			font-weight: 400;
			line-height: 1.5;
			color: #212529;
			background-color: #fff;
			-webkit-text-size-adjust: 100%;
			-webkit-tap-highlight-color: transparent;
		}
		    .cta-btn-llamen {
        border-radius: 8px;
        border: 1px solid #1a73e8 !important;
        color: #1a73e8;
        background: white !important;
        width: 200px;
    }

    .cta-btn-llamen:hover {
        border: 1px solid #fff;
        color: #1a73e8;
        background: white;
    }

    .cta-btn-llamar {
        border-radius: 8px;
        background: #1a73e8 !important;
        color: white !important;
        width: 200px;
    }

    .cta-btn-llamar:hover {
        background: #1a73e8;
        color: white;
    }

    .cta-atencion-wrapper {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        z-index: 998;
        background-color: transparent;
        pointer-events: none;
    }

    .cta-atencion-container {
        pointer-events: auto;
    }

    /* Bootstrap utility clases for first paint */
    .d-flex {
        display: flex !important;
    }

    .align-items-center {
        align-items: center !important;
    }

    .justify-content-between {
        justify-content: space-between !important;
    }

    .justify-content-center {
        justify-content: center !important;
    }

    .flex-grow-1 {
        flex-grow: 1 !important;
    }

    .mb-3 {
        margin-bottom: 1rem !important;
    }

    .mt-3 {
        margin-top: 1rem !important;
    }

    .me-2 {
        margin-right: 0.5rem !important;
    }

    .m-0 {
        margin: 0 !important;
    }

    .d-none {
        display: none !important;
    }

    .fw-bold {
        font-weight: 700 !important;
    }

    .btn {
        display: inline-block;
        font-weight: 400;
        line-height: 1.5;
        text-align: center;
        text-decoration: none;
        vertical-align: middle;
        cursor: pointer;
        padding: .375rem .75rem;
        font-size: 1rem;
        border-radius: .25rem;
    }

    @media (min-width: 768px) {
        .cta-atencion {
            min-height: 65px
        }
    }

    .cta-atencion {
        flex-wrap: nowrap;
    }



    @media (min-width: 769px) {
        .cta-btn-llamar:hover .cta-btn-text {
            display: none !important;
        }

        .cta-btn-llamar:hover .cta-btn-hover-text {
            display: block !important;
        }
    }

    @media (max-width: 768px) {
        .cta-btn-llamar {
            padding: 3px;
        }

        .cta-btn-llamen {
            padding: 3px;
        }

        .cta-atencion {
            flex-direction: column;
            align-items: stretch !important;
        }

        .w-100-mobile {
            width: 100%;
            justify-content: space-between;
        }

        .cta-chevron {
            display: block !important;
        }

        .cta-buttons {
            width: 100%;
            justify-content: space-between;
            /* display: flex; */
            margin-top: 15px;
            overflow: hidden;
            max-height: 200px;
            transition: max-height 0.3s ease, margin-top 0.3s ease, opacity 0.3s ease;
        }

        .cta-buttons.collapsed {
            max-height: 0;
            margin-top: 0;
            opacity: 0;
        }

        .cta-buttons .btn {
            flex: 1;
            font-size: 14px;
        }
    }

    .d-flex {
        display: flex !important;
    }

    .flex-column {
        flex-direction: column !important;
    }

    #carrPaq_hogarHome {
        font-family: 'Roboto', sans-serif !important;
        color: #55667A;
        background: transparent;
        direction: ltr;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        -webkit-tap-highlight-color: transparent;
        -webkit-text-size-adjust: none;
        -ms-touch-action: manipulation;
        touch-action: manipulation;
        -webkit-font-feature-settings: "liga" 0;
        font-feature-settings: "liga" 0;
        font-family: sans-serif;
        line-height: 1.15;
        -webkit-text-size-adjust: 100%;
        -webkit-tap-highlight-color: transparent;
        font-size: 1rem;
    }

    #carrPaq_hogarHome * {
        box-sizing: border-box;
    }

    .container {
        --bs-gutter-x: 1.5rem;
        --bs-gutter-y: 0;
        width: 100%;
        padding-right: calc(var(--bs-gutter-x) * .5);
        padding-left: calc(var(--bs-gutter-x) * .5);
        margin-right: auto;
        margin-left: auto
    }

    @media (min-width:576px) {
        .container {
            max-width: 540px
        }
    }

    @media (min-width:768px) {
        .container {
            max-width: 720px
        }
    }

    @media (min-width:992px) {
        .container {
            max-width: 960px
        }
    }

    @media (min-width:1200px) {
        .container {
            max-width: 1140px
        }
    }

    @media (min-width:1400px) {
        .container {
            max-width: 1320px
        }
    }

    .mx-auto {
        margin: 0 auto;
    }

    .fullBox2 {
        width: 90%;
        max-width: 1160px;
        margin: 0 auto;
        clear: both;
        display: block;
    }

    .text-center {
        text-align: center;
    }

    .container_divs_c {
        display: flex;
        margin: 30px auto;
        width: 100%;
        align-items: center;
        text-align: center;
        justify-items: center;
        justify-content: center;
    }


    .telefonia_internet_c,
    .solo_internet_c {
        width: 200px;
        height: 56px;
        border-radius: 30px;
        background: #fff;
        font-family: 'Roboto', sans-serif !important;
        font-weight: 600;
        text-align: center;
        margin: 0 4.5px;
        cursor: pointer;
        font-size: 14px;
    }

    .telefonia_internet_c {
        color: #17B9FD;
        border: 2px solid #17B9FD;
    }

    .solo_internet_c {
        color: #007bff;
        border: 2px solid #007bff;
    }

    .telefonia_internet_c p,
    .solo_internet_c p {
        margin: 0 auto;
        padding: 17px 0
    }

    .telefonia_internet_c.selected {
        background: #17B9FD;
        border: 2px solid #17B9FD;
        color: #fff;
    }

    .solo_internet_c.selected {
        background: #2556F0;
        border: 2px solid #2556F0;
        color: #fff;
    }

    .container_tarjetas_c {
        display: inline-block;
        width: 100%;
        max-width: 1160px;
        margin: auto;
    }

    .container_tarjetas_c .tarjeta_paq_c {
        height: auto;
        transition: transform 0.3s linear;
        transition-delay: 0.5s;
        margin-bottom: 10px;
        border: solid 1px #E3E1E1;
    }

    .tarjeta_paq_c {
        width: 275px;
        max-width: 275px;
        border-radius: 12px;
        float: left;
        margin: 0 8px;
        background: white;
    }

    .tarjeta_paq_c:hover {
        outline: 2px solid #0067ee;
    }

    .tarjeta_paq_c.naked {
        height: auto;
    }

    .container_tarjetas_c:not(.slick-initialized) {
        display: flex;
        overflow-x: auto;
        padding-bottom: 20px;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
    }

    .pe-4 {
        padding-right: 1.5rem !important
    }

    .pb-2 {
        padding-bottom: .5rem !important
    }

    .container_tarjetas_c:not(.slick-initialized)::-webkit-scrollbar {
        display: none;
    }

    .container_tarjetas_c:not(.slick-initialized) .tarjeta_paq_c {
        flex: 0 0 auto;
        scroll-snap-align: center;
        float: none;
    }

    @media (max-width: 768px) {
        .container_tarjetas_c:not(.slick-initialized) {
            padding: 0 calc(50vw - 145.5px);
        }
    }

    .megas_c {
        color: #fff;
        border-radius: 10px 10px 0 0;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        height: fit-content;
    }

    .naked .megas_c h3,
    .naked .megas_c .titulo_megas {
        color: #2556F0 !important;
    }

    .paq .megas_c h3,
    .paq .megas_c .titulo_megas {
        color: #17B9FD;
    }

    .megas_c h4,
    .megas_c h3,
    .megas_c .titulo_megas {
        font-size: 61px;
        margin: 0;
        /* font-family: "Changa One", sans-serif !important; */
        line-height: inherit;
        font-weight: 700;
    }

    .megas_c h4 span,
    .megas_c h3 span,
    .megas_c .titulo_megas span {
        font-size: 20px;
        margin-left: 5px;
        /* font-family: "Changa One", sans-serif !important; *7
    }

    .megas_d h4,
    .megas_d h3 {
        font-size: 50px;
        margin: 0;
        font-family: 'Roboto', sans-serif !important;
        line-height: inherit;
    }

    .megas_d h4 span,
    .megas_d h3 span {
        font-size: 20px;
        margin-left: 5px;
        font-family: 'Roboto', sans-serif !important;
    }

    .nota_especial_c {
        color: #1a1a1a;
        background: #ff9300;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .nota_especial_c-bla {
        color: #fff;
        background: #000;
        text-align: center;
        position: absolute;
        width: 271px;
    }

    .nota_especial_c-bla p {
        display: flex;
        width: 100%;
        justify-content: center;
        align-items: center;
        margin: 5px auto;
    }

    .nota_especial_c-bla p img {
        height: 18px;
        margin-right: 10px;
    }

    .nota_especial_c p {
        margin: 0;
        font-family: 'Roboto';
        font-weight: bold;
        padding: 3px 0;
    }

    .nota_especial_d {
        color: #fff;
        text-align: center;
        position: absolute;
        width: 271px;
        margin: 4px 0px;
        font-size: 12px;
    }

    .precio_c {
        text-align: center;
        background: #de2f1b;
        max-width: 240px;
        margin: 10px auto;
        border-radius: 10px;
        padding: 4% 0%;
    }

    .precio_c p {
        text-align: center;
        color: #1a1a1a;
        font-size: 15px;
    }

    .precio_c .numeros_c {
        font-size: 40px;
        color: #fff;
        /* font-family: "Changa One", sans-serif !important; */
    }

    .precio_c .bold_c {
        /* font-family: "Changa One", sans-serif !important; */
        font-size: 15px;
        color: #fff;
    }


    /* estilos del tootip */

    @media (max-width: 600px) {

        .container_divs_c {
            margin: 10px auto 30px;
        }

        .telefonia_internet_c,
        .solo_internet_c {
            border-radius: 30px;
            width: 272px;
            margin: 6.5px auto;
        }
    }



    /* ESTILOS NUEVOS PARA LA TARJETA (NUEVO DISEÑO) */
    .tarjeta_paq_c {
        border-radius: 12px;
        background: #fff;
        border: 1px solid #17B9FD;
        padding: 10px 10px;
        text-align: center;
        position: relative;
        font-family: 'Roboto', sans-serif;
        width: 275px;
        max-width: 275px;
        float: left;
        margin: 8px 8px;
    }

    .selec-group {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
    }

    .custom-checkbox {
        display: flex;
        align-items: center;
        cursor: pointer;
        position: relative;
        padding-left: 30px;
        font-size: 14px;
        margin-bottom: 0;
        height: 45px;
    }

    .custom-checkbox input {
        position: absolute;
        opacity: 0;
        cursor: pointer;
    }

    .checkmark {
        position: absolute;
        left: 0;
        height: 20px;
        width: 20px;
        border: 2px solid #0067ee;
        border-radius: 4px;
        background-color: transparent;
    }

    .custom-checkbox input:checked~.checkmark {
        background-color: #0067ee;
        border-color: #0067ee;
    }

    .checkmark:after {
        content: "";
        position: absolute;
        display: none;
        left: 5px;
        top: 1px;
        width: 6px;
        height: 12px;
        border: solid white;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
    }

    .custom-checkbox input:checked~.checkmark:after {
        display: block;
    }

    img.prom_logo_netflix {
        height: 35px;
        margin-left: 5px;
    }

    img.prom_logo_hbo {
        height: 35px;
        margin-left: 5px;
    }

    img.prom_logo_f1 {
        width: 65px;
        margin-left: 5px;
    }

    @keyframes shimmer {
        0% {
            background-position: -600px 0;
        }

        100% {
            background-position: 600px 0;
        }
    }

    .megas_c h3,
    .megas_c .titulo_megas {
        font-size: 55px;
        color: #17B9FD;
        margin: 0;
        line-height: 1;
        font-weight: 900;
    }

    .megas_c h3 span,
    .megas_c .titulo_megas span {
        font-size: 20px;
    }

    .megas_c p {
        font-size: 14px;
        font-weight: bold;
        margin-top: 5px;
        margin-bottom: 0px;
        color: #000;
    }

    .precio_c {
        background: #E32B14;
        color: #fff;
        border-radius: 6px;
        margin: 15px 10px;
        padding: 10px;
    }

    .precio_c .numeros_c {
        font-size: 30px;
        font-weight: 900;
    }

    .precio_c .bold_c {
        font-size: 14px;
        font-weight: bold;
    }

    .promociones_badge {
        background: #17B9FD;
        color: #fff;
        border-radius: 20px;
        padding: 3px 15px;
        display: inline-block;
        font-size: 12px;
        font-weight: bold;
        margin-top: 15px;
        position: relative;
        z-index: 2;
    }

    .promociones_content {
        border: 1px solid #17B9FD;
        border-radius: 10px;
        padding: 20px 10px 10px;
        margin-top: -12px;
        position: relative;
    }

    .promociones_content .titulo_promo {
        color: #000;
        margin-bottom: 15px;
    }

