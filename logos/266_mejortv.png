                                        class="prom_logo_netflix"> --> </label> <label class="custom-checkbox"> <!-- <input type="checkbox" name="hbo"> --> <span class="checkmark"></span> <!-- <img width="90" height="20"  src="/documents/d/hogar/hbo-max_logo_obsidian-black_rgb_052225" alt="HBO Max"
                                        class="prom_logo_hbo"> --> </label> <label class="custom-checkbox"> <!-- <input type="checkbox" name="f1"> --> <span class="checkmark"></span> <!-- <img width="60" height="20"  src="/documents/575301/3619211/F1_TV.svg" alt="F1 TV" class="prom_logo_f1"> --> </label>
                </div>
                <p class="font-weight-bold" style="color: black;">6 meses van por nuestra cuenta</p>
               </div>
               <div class="modal-hgr-btn-primary mt-3"><a id="btn-contratar-modal" href="#" target="_self">Continuar orden</a>
               </div>
              </div> <!-- Step 1: Formulario de contacto -->
              <div id="modalTecDomiStep1" style="color: black; display: none;">
               <div class="mt-4 h5 font-weight-bold">
                Para continuar tu contratación ingresa tus datos
               </div>
               <div class="mb-4 h6">
                Uno de nuestros asesores te contactará
               </div>
               <div class="medio pad_rig_res wi100" id="wrap-td-nombre">
                <p class="tit_campo">Nombre y apellido*</p>
                <p class="input_campo"><input type="text" id="td-nombre" name="td-nombre" maxlength="80" onkeyup="this.value = this.value.replace(/[^a-zA-Z\u00e1\u00e9\u00ed\u00f3\u00fa\u00c1\u00c9\u00cd\u00d3\u00da\u00fc\u00dc\u00f1\u00d1 ]/g,'');" autocomplete="new-password"></p>
                <p id="err-td-nombre" class="error_campo">Este campo es requerido</p>
               </div>
               <div class="medio pad_rig_res wi100" id="wrap-td-cel">
                <p class="tit_campo">Celular a 10 dígitos*</p>
                <p class="input_campo"><input type="tel" id="td-cel" name="td-cel" maxlength="10" oninput="this.value = this.value.replace(/\D/g,'').slice(0,10);" autocomplete="new-password"></p>
                <p id="err-td-cel" class="error_campo">Este campo es requerido</p>
               </div>
               <div class="medio pad_rig_res wi100" id="wrap-td-email">
                <p class="tit_campo">Correo electrónico</p>
                <p class="input_campo"><input type="email" id="td-email" name="td-email" autocomplete="new-password"></p>
                <p id="err-td-email" class="error_campo">Este campo es requerido</p>
               </div>
               <div class="medio pad_rig_res wi100" id="wrap-td-cp">
                <p class="tit_campo">Código Postal*</p>
                <p class="input_campo"><input type="tel" id="td-cp" name="td-cp" maxlength="5" oninput="this.value = this.value.replace(/\D/g,'').slice(0,5);" autocomplete="new-password"></p>
                <p id="err-td-cp" class="error_campo">Este campo es requerido</p>
               </div>
               <p class="my-4" style="color: #55667a">*Campos obligatorios</p>
               <div class="modal-hgr-btn-primary mt-3"><a id="btn-domi-modal" class="w-100" href="#" target="_self" style="color: #0070c0"> Hablar con un asesor </a>
               </div>
               <div class="my-4 text-center">
                <p class="" style="color: black">O si prefieres, llámanos al: <a href="tel:8001231012" style="color: #0070c0">800 123 1012</a></p>
               </div>
              </div> <!-- Step 2: Confirmación de envío -->
