  }

  .legal-links li:not(:last-child)::after {
    content: '|';
    margin-left: 10px;
    margin-right: 5px;
    color: #55667a;
  }

  /* Skeleton shimmer - Performance Optimized */
  .img-skeleton {
    display: block;
    border-radius: 6px;
    background: #e0e5ec;
    position: relative;
    overflow: hidden;
  }

  .img-skeleton::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: linear-gradient(90deg,
        transparent 0%,
        rgba(255, 255, 255, 0.4) 40%,
        transparent 80%);
    animation: skeleton-wave 1.4s linear infinite;
  }

  .app-img .img-skeleton {
    height: 35px;
    width: 110px;
  }

  .social-img .img-skeleton {
    width: 35px;
    height: 35px;
    border-radius: 50%;
  }

  @keyframes skeleton-wave {
    0% {
      transform: translateX(-100%);
    }

    100% {
      transform: translateX(100%);
    }
  }

  /* Mobile Styles */
  @media (max-width: 768px) {
    .top-footer {
      flex-direction: column;
      text-align: center;
      gap: 30px;
    }

    .apps-section,
    .social-section {
