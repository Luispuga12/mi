         <script>
    function setupVerticalCarousel(trackId, toggleBtnId, toggleIconId) {
        const track = document.getElementById(trackId);
        const toggleBtn = document.getElementById(toggleBtnId);
        const toggleIcon = document.getElementById(toggleIconId);
        if (!track || !toggleBtn || !toggleIcon) return null;
        
        const scrollContainer = track.querySelector('.carousel-page');
        if (!scrollContainer) return null;
        
        function updateScrollIcon() {
            const maxScroll = scrollContainer.scrollHeight - scrollContainer.clientHeight;
            if (maxScroll <= 10) return;
            if (scrollContainer.scrollTop >= maxScroll - 40) {
                toggleIcon.innerHTML = '<path d="m18 15-6-6-6 6"/>'; // Flecha arriba
            } else if (scrollContainer.scrollTop <= 40) {
                toggleIcon.innerHTML = '<path d="m6 9 6 6 6-6"/>'; // Flecha abajo
            }
        }
        
        scrollContainer.addEventListener('scroll', updateScrollIcon);
        
        toggleBtn.addEventListener('click', (e) => {
            e.preventDefault();
            const maxScroll = scrollContainer.scrollHeight - scrollContainer.clientHeight;
            if (maxScroll > 10) {
                if (scrollContainer.scrollTop >= maxScroll - 40) {
                    scrollContainer.scrollTo({
                        top: 0,
                        behavior: 'smooth'
                    });
                } else {
                    scrollContainer.scrollTo({
                        top: scrollContainer.scrollHeight,
                        behavior: 'smooth'
                    });
                }
            } else {
                const isBottom = (window.innerHeight + window.pageYOffset) >= document.body.offsetHeight - 100;
                if (isBottom) {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                } else {
                    window.scrollBy({ top: 400, behavior: 'smooth' });
                }
            }
        });
        
        updateScrollIcon();
        
        return {
            reset: function() {
                scrollContainer.scrollTo({ top: 0, behavior: 'smooth' });
                toggleIcon.innerHTML = '<path d="m6 9 6 6 6-6"/>';
            },
            getPage: function() {
                return 0;
            }
        };
    }

    document.addEventListener('DOMContentLoaded', () => {
        // Inicializar Carruseles (Telefonía + Internet y Solo Internet)
        window.carouselPaq = setupVerticalCarousel('track_paq', 'toggleBtn_paq', 'toggleIcon_paq');
        window.carouselNaked = setupVerticalCarousel('track_naked', 'toggleBtn_naked', 'toggleIcon_naked');

        // Posicionar pantalla en carrPaq_hogarHome al hacer clic en cualquier selector
        document.addEventListener('click', (e) => {
            const selector = e.target.closest('#selectores_c > div, .container_divs_c > div');
            if (selector && e.isTrusted) {
                const target = document.getElementById('carrPaq_hogarHome');
                if (target) {
                    const headerOffset = 80;
                    const elementPosition = target.getBoundingClientRect().top;
                    const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
                    window.scrollTo({
                        top: offsetPosition,
                        behavior: 'smooth'
                    });
                }
            }
        });
    });
</script>
         <div id="">
          <div id="carrPaq_hogarHome" class="fullBox2 mx-auto mb-5">
           <div id="selectores_c" class="container_divs_c">
