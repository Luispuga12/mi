                 <svg id="cta-chevron-icon" width="28" height="28" viewbox="0 0 24 24" fill="none" stroke="#1a73e8" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="transition: transform 0.3s; transform: rotate(180deg);"><polyline points="6 9 12 15 18 9"></polyline>
