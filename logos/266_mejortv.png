                    },
                    {
                        type: "inline",
                        content: "(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-WF2W3C');"
                    },
                ];

                Promise.all(scripts.map(item => {
                    return new Promise((resolve, reject) => {
                        if (item.type === 'css') {
                            const link = document.createElement('link');
                            link.rel = 'stylesheet';
                            link.href = item.url;
                            link.onload = resolve;
                            link.onerror = reject;
                            document.head.appendChild(link);
                            return;
                        }

                        const script = document.createElement('script');
                        script.async = false; // Mantiene el orden de ejecución (jquery primero, luego slick)

                        if (typeof item === 'string') {
                            script.src = item;
                            script.onload = resolve;
                            script.onerror = reject;
                        } else if (item.type === 'inline') {
                            script.textContent = item.content;
                            document.head.appendChild(script);
                            return resolve();
                        }

                        document.head.appendChild(script);
                    });
                }))
                    .then(() => {
                        initCarruselHogar()
                    })
                    .catch(err => console.error("Error al cargar scripts de contratación:", err));


            };

            eventosCriticos.forEach(evento => {
                window.addEventListener(evento, cargarScriptsCriticos, { passive: true });
            });

            // Lógica de banner movida a carga directa con fetchpriority high
        </script>
           <script>
            document.addEventListener("DOMContentLoaded", function () {
                //document.querySelectorAll(".autofit-float").forEach(el => el.style.display = 'none');
                //document.querySelectorAll(".cadmin").forEach(el => el.style.display = 'none');
            });

            const matrizPromos = [
                {
                    "precio": 0,
                    "precioSinPromo": 109,
                    "familia": "Netflix",
                    "logoCuadro": "/documents/d/contrata/cuadro-netflix",
                    "isPromo": true,
                    "leyendaPromo": "Va por nuestra cuenta durante 6 meses por el mismo precio de tu Paquete.",
                    "detalle": "Estándar con anuncios",
                    "descripcion": "2 dispositivos Full HD",
                    "clave": "NFX07_P",
                    "logo": "/documents/d/contrata/logo-netflix-png",
                    "order": 4
                },
                {
                    "precio": 0,
                    "precioSinPromo": 119,
                    "logoCuadro": "/documents/d/contrata/cuadro-hbo",
                    "familia": "HBO Max",
                    "isPromo": true,
                    "leyendaPromo": "Al domiciliar el pago de tu servicio va por nuestra cuenta durante 3 meses por el mismo precio de tu Paquete.",
                    "detalle": "Estándar con anuncios",
                    "descripcion": "2 dispositivos Full HD",
                    "clave": "MAXCA_P",
                    "logo": "/documents/d/contrata/hbo-max_logo_obsidian-black_rgb_052225",
                    "order": 4
                },
                {
                    "precio": 0,
                    "precioSinPromo": 99,
                    "logoCuadro": "/documents/d/contrata/cuadro-f1",
                    "familia": "Formula 1",
                    "isPromo": true,
                    "leyendaPromo": "Incluido 6 meses",
                    "detalle": "TV Pro",
                    "descripcion": "1 dispositivo Full HD",
                    "codigo": "F1001_P",
                    "logo": "/documents/575301/3619211/F1_TV.svg",
                    "order": 0,
                    "leyendaPromoCarrito": "Al domiciliar el pago de tu servicio va por nuestra cuenta durante 6 meses por el mismo precio de tu Paquete."
                }
            ]

            window.guardarChecks = function (btn, clave) {
                const tarjeta = btn.closest('.tarjeta_paq_c');
                const checkboxesTotal = tarjeta ? tarjeta.querySelectorAll('input[type="checkbox"]') : [];
                const checkboxesMarcados = tarjeta ? tarjeta.querySelectorAll('input[type="checkbox"]:checked') : [];
                
                const nameToFamilia = {
                    'netflix': 'Netflix',
                    'hbo': 'HBO Max',
                    'f1': 'Formula 1'
                };

                if (checkboxesTotal.length > 0 && checkboxesMarcados.length === 0) {
                    if (window.event) window.event.preventDefault();
                    
                    const overlay = document.getElementById('modalTecDomi');
                    if (overlay) {
                        overlay.classList.remove('ln-overlay--hidden');
                        overlay.classList.add('ln-overlay--visible');
                    }
                    if (document.getElementById('modalTecDomiStep1')) document.getElementById('modalTecDomiStep1').style.display = 'none';
                    if (document.getElementById('modalTecDomiStep2')) document.getElementById('modalTecDomiStep2').style.display = 'none';
                    if (document.getElementById('modalTecDomiStep0')) document.getElementById('modalTecDomiStep0').style.display = 'block';
                    
                    const btnContinuar = document.getElementById('btn-contratar-modal');
                    if (btnContinuar) {
                        btnContinuar.href = btn.href;
                        btnContinuar.onclick = function() {
                            const modalStep0 = document.getElementById('modalTecDomiStep0');
                            const modalChecks = modalStep0.querySelectorAll('input[type="checkbox"]:checked');
                            const promosSeleccionadas = [];
                            modalChecks.forEach(cb => {
                                const familia = nameToFamilia[cb.name];
                                const promo = matrizPromos.find(p => p.familia === familia);
                                if (promo) promosSeleccionadas.push(promo);
                            });
                            sessionStorage.setItem("seleccionEntretenimientos", JSON.stringify(promosSeleccionadas));
                        };
                    }
                    return false;
                }

                const promosSeleccionadas = [];
                const checksHomeSuffixArray = [];
                if (checkboxesMarcados) {
                    checkboxesMarcados.forEach(cb => {
                        checksHomeSuffixArray.push(cb.name);
                        const familia = nameToFamilia[cb.name];
                        const promo = matrizPromos.find(p => p.familia === familia);
                        if (promo) promosSeleccionadas.push(promo);
                    });
                }
                sessionStorage.setItem("seleccionEntretenimientos", JSON.stringify(promosSeleccionadas));

                const checksHomeSuffix = checksHomeSuffixArray
                    .filter(Boolean)
                    .map(v => String(v).trim().toUpperCase().replace(/\s+/g, "_"))
                    .join("_");

                if (checksHomeSuffix.length > 0 && typeof dataLayer !== "undefined") {
                    dataLayer.push({
                        event: "addevent",
                        "macro-page": window.location.pathname,
                        "event-value": "checkHome_" + checksHomeSuffix,
                    });
                }

                console.log("Contratar", clave, "Promociones:", promosSeleccionadas);
            };

