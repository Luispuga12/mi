    .container_tarjetas_c .tarjeta_paq_c {
        height: auto;
        transition: transform 0.3s linear;
        transition-delay: 0.5s;
        margin-bottom: 10px;
        border: solid 1px #E3E1E1;
    }

    .container_tarjetas_c .slick-track {
        display: flex;
        align-items: stretch;
        flex-direction: row;
