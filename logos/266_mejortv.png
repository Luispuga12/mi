            /* ── lnOverlay ── */
            .ln-overlay {
                position: fixed;
                inset: 0;
                z-index: 9999;
                display: flex;
                align-items: center;
                justify-content: center;
                background: rgba(57, 57, 57, 0.5) none repeat scroll 0% 0% !important;
                opacity: 0;
                transition: opacity 0.35s ease;
                pointer-events: none;
            }

            .ln-overlay.ln-overlay--visible {
                opacity: 1;
                pointer-events: all;
            }

            .ln-overlay.ln-overlay--hidden {
                opacity: 0;
                pointer-events: none;
            }

            @keyframes cardFadeIn {
                from {
                    opacity: 0;
                    transform: translateY(15px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .ln-overlay__card {
                position: relative;
                background: #ffffff;
                border-radius: 12px;
                padding: 32px;
                min-width: 320px;
                max-width: 500px;
                box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
                opacity: 0;
                animation: cardFadeIn 0.6s ease 0.1s forwards;
            }

            .ln-overlay__close {
                position: absolute;
                top: 10px;
                right: 14px;
                background: none;
                border: none;
                font-size: 22px;
                line-height: 1;
                color: #5a6478;
                cursor: pointer;
                padding: 0;
                transition: color 0.2s ease;
            }

            .ln-overlay__close:hover {
                color: #de2f1b;
            }

            /* ─── Botones exclusivos del modal #modalNoticias (HGR) ─── */
            .modal-hgr-btn-primary {
                text-align: center;
                margin: 25px auto 0px auto;
            }

            .modal-hgr-btn-primary a,
            .modal-hgr-btn-primary a:hover,
            .modal-hgr-btn-primary a:focus {
                background: #de2f1b;
                color: #fff !important;
                font-family: Arial, sans-serif !important;
                font-weight: 600;
                font-size: 16px;
                border-radius: 10px;
                padding: 16px 10px;
                text-decoration: none !important;
                width: 240px;
                display: block;
                margin: 0 auto;
            }

            .modal-hgr-btn-secondary {
                color: #0067ee;
                text-align: center;
                margin: 0;
                font-family: 'Roboto';
                font-weight: bold;
                font-size: 16px;
                margin: 30px auto 0 auto;
            }

            /* ─── Fin botones modal HGR ─── */

            /* ─── Estilos form campos #modalTecDomi (portados de Disney-css) ─── */
            #modalTecDomi .medio,
            #modalTecDomi .medio_datos {
                width: 100%;
                vertical-align: top;
                vertical-align: baseline;
                position: relative;
                margin-bottom: 4px;
            }

            #modalTecDomi .tit_campo {
                font-family: Roboto, Arial, sans-serif;
                font-size: 14px;
                color: #1a1a1a;
                position: relative;
                top: 11px;
                left: 10px;
                background: #fff;
                width: fit-content;
                padding: 1px 10px;
                box-sizing: border-box;
                margin-bottom: 0;
            }

            #modalTecDomi p.input_campo {
                display: flex;
                margin-bottom: 0;
            }

            #modalTecDomi .input_campo input[type="text"],
            #modalTecDomi .input_campo input[type="number"],
            #modalTecDomi .input_campo input[type="email"],
            #modalTecDomi .input_campo input[type="tel"],
            #modalTecDomi .input_campo input {
                width: 100%;
                border: 1px solid #ebebeb;
                background-color: #ffffff;
                padding: 10px;
                font-size: 16px;
                box-sizing: border-box;
                height: auto;
                border-radius: 5px;
                color: #55667a;
                font-family: Roboto, Arial, sans-serif;
            }

            #modalTecDomi .input_campo input[type="email"] {
                text-transform: unset !important;
            }

            #modalTecDomi .input_campo input:focus {
                outline: none;
                border-color: #0067ee;
                box-shadow: 0 0 0 2px rgba(0, 103, 238, 0.15);
            }

            #modalTecDomi .error_campo {
                font-family: Roboto, Arial, sans-serif;
                font-size: 13px;
                color: #de2f1b;
                display: none;
                margin-top: 10px !important;
                margin-bottom: 8px;
                padding-left: 12px;
            }

            #modalTecDomi .wi100 {
                width: 100% !important;
            }

            #modalTecDomi .pad_rig_res {
                padding: 0;
            }

            /* ─── Fin estilos form campos modal HGR ─── */
        </style>
           <div id="modalTecDomi" class="ln-overlay ln-overlay--hidden">
            <div class="ln-overlay__card" style="width: 95%; max-width: 400px; padding: 0; background-color: #fff; border-radius: 20px; overflow: hidden; border: none; position: relative;">
             <div class="modal-body p-4 position-relative"><button type="button" class="ln-overlay__close" aria-label="Cerrar" onclick="cerrarModalTecDomi()"> × </button> <!-- Step 0: Selección de entretenimiento (antes era #modalNoticias) -->
              <div id="modalTecDomiStep0">
               <div class="mb-4 h3 text-center" style="color: blue">
                ¡Espera!
               </div>
               <div class="px-1 font-weight-bold text-center" style="font-size: 0.95rem;">
                <p class="mb-3" style="color: black;">No seleccionaste ninguna promoción de entretenimiento</p>
               </div>
