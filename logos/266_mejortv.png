         <script>
  // Función para cargar diferidamente las imágenes del footer (apps y redes sociales)
  // Basada en el patrón de cargarScriptsCriticos de Linea_nv_const
  let imagenesFooterCargadas = false;
  const eventosImagenesFooter = ['mouseover', 'keydown', 'touchstart', 'wheel'];

  function cargarImagenesFooter() {
    if (imagenesFooterCargadas) return;
    imagenesFooterCargadas = true;

    eventosImagenesFooter.forEach(evento => {
      window.removeEventListener(evento, cargarImagenesFooter, { passive: true });
    });

    const imagenesFooter = [
      // Footer superior
      {
        selector: 'a[href="/web/blog"]',
        src: '/documents/d/global/ico_blog_footer',
        alt: 'icono_Blog',
        style: 'max-width: 60px;',
        width: 60,
        height: 60
      },
      {
        selector: '#logoProfecoBlanco',
        src: '/documents/d/global/distintivo-profeco_blanco',
        alt: 'Distintivo Digital Profeco',
        style: 'width: 100px;',
        width: 100,
        height: 15
      },
      {
        selector: '#logoProfecoBlancoMobile',
        src: '/documents/d/global/distintivo-profeco_blanco',
        alt: 'Distintivo Digital Profeco',
        style: 'width: 100px;',
        width: 100,
        height: 15
      },
      {
        selector: '#logoProfeco',
        src: '/documents/d/global/distintivo-profeco',
        alt: 'Distintivo Digital Profeco',
        style: 'width: 250px;',
        width: 250,
        height: 80
      },
      // Apps
      {
        selector: 'a.app-img[href*="play.google.com"]',
        src: '/documents/37246/0/ic_130522_google_play_3.png',
        alt: 'Google Play',
        width: 110,
        height: 35
      },
      {
        selector: 'a.app-img[href*="itunes.apple.com"]',
        src: '/documents/37246/0/apple_store_badge.svg',
        alt: 'App Store',
        width: 110,
        height: 35
      },
      {
        selector: 'a.app-img[href*="appgallery5.huawei.com"]',
        src: '/documents/37246/0/huawei-play.png',
        alt: 'AppGallery',
        width: 110,
        height: 35
      },
      // Redes sociales
      {
        selector: 'a.social-img[href*="twitter.com"]',
        src: '/documents/d/global/x-twitter',
        alt: 'X',
        width: 35,
        height: 35
      },
      {
        selector: 'a.social-img[href*="facebook.com"]',
        src: '/documents/37246/0/facebook.svg/731f8ad2-b547-0c8f-d64b-11a5e30d100a?t=1629915308362',
        alt: 'Facebook',
        width: 35,
        height: 35
      },
      {
        selector: 'a.social-img[href*="instagram.com"]',
        src: '/documents/37246/0/instagram_4.svg',
        alt: 'Instagram',
        width: 35,
        height: 35
      },
      {
        selector: 'a.social-img[href*="youtube.com"]',
        src: '/documents/37246/0/youtube.svg',
        alt: 'YouTube',
        width: 35,
        height: 35
      },
      {
        selector: 'a.social-img[href*="linkedin.com"]',
        src: '/documents/37246/0/linkedin_4.svg',
        alt: 'LinkedIn',
        width: 35,
        height: 35
      }
    ];

    imagenesFooter.forEach(({ selector, src, alt, style, width, height }) => {
      document.querySelectorAll(selector).forEach(enlace => {
        // Eliminar el skeleton antes de insertar la imagen real
        const skeleton = enlace.querySelector('.img-skeleton');
        if (skeleton) skeleton.remove();

        const img = document.createElement('img');
        img.src = src;
        img.alt = alt;

        if (width) img.width = width;
        if (height) img.height = height;
        if (style) img.setAttribute('style', style);

        enlace.appendChild(img);
      });
    });
  };

  eventosImagenesFooter.forEach(evento => {
    window.addEventListener(evento, cargarImagenesFooter, { passive: true });
  });
</script>
