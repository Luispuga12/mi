            function resetSessions() {
                sessionStorage.removeItem("checksHome")
                sessionStorage.removeItem("dts")
                sessionStorage.removeItem("seleccionEntretenimientos")
                sessionStorage.removeItem("pasoActual")
            }

            document.addEventListener("DOMContentLoaded", function () {
                resetSessions()

                if (window.location.pathname.includes('cambiate-a-telmex')) {
                    return
                    document.querySelectorAll('.promociones_content .meses_promo').forEach(function(el) {
                        var p = document.createElement('p');
                        p.className = 'txt-portabilidad-requisitos mt-2 mb-0 text-center';
                        p.style.fontSize = '11px';
                        p.style.borderTop = '1px solid #17B9FD';
                        p.style.paddingTop = '15px';
                        p.style.color = 'black';
                        p.style.fontWeight = 'bold';
                        p.innerHTML = `Porta tu número de otra<br>compañía a Telmex y disfruta de<br>
                            <strong>3 meses de servicio y gastos de<br></strong>instalación SIN COSTO<br>
                            Aplica para los meses 4, 8 y 12`
                        el.parentNode.insertBefore(p, el.nextSibling);
                    });
                }
            });

            function initCarruselHogar() {

								if (!window.carouselPaq && typeof setupVerticalCarousel === "function") {
										window.carouselPaq = setupVerticalCarousel('track_paq', 'toggleBtn_paq', 'toggleIcon_paq');
								}
								if (!window.carouselNaked && typeof setupVerticalCarousel === "function") {
										window.carouselNaked = setupVerticalCarousel('track_naked', 'toggleBtn_naked', 'toggleIcon_naked');
								}

								function paquetesCarrusel(tipoSeleccionado, quitaSeleccion) {
										if (tipoSeleccionado === "paq" && window.carouselPaq) {
												window.carouselPaq.reset();
										} else if (tipoSeleccionado === "naked" && window.carouselNaked) {
												window.carouselNaked.reset();
										}
								} // Fin de paquetesCarrusel

								$(document).off('click', '.solo_internet_c').on('click', '.solo_internet_c', function () {
										$(".telefonia_internet_c").removeClass("selected");
										$(this).addClass("selected");
										$('#carrusel_paq').removeClass("activo").hide();
										$('#carrusel_naked').addClass("activo").show();
										paquetesCarrusel("naked", "paq");
										$('.leg_paq').hide();
										$('.leg_sol').show();
								});

								$(document).off('click', '.telefonia_internet_c').on('click', '.telefonia_internet_c', function () {
										$(".solo_internet_c").removeClass("selected");
										$(this).addClass("selected");
										$('#carrusel_naked').removeClass("activo").hide();
										$('#carrusel_paq').addClass("activo").show();
										paquetesCarrusel("paq", "naked");
										$('.leg_sol').hide();
										$('.leg_paq').show();
								});

								function cambiaSeleccion(tipo, ent) {
										if (tipo === "PAQUETE") {
												$('.telefonia_internet_c').trigger('click');
										} else {
												$('.solo_internet_c').trigger('click');
										}

										if (ent) {
												$("#ent_" + ent).addClass("selected");
												$("#ent_" + ent).find(".ent-checkbox").addClass("checked");
												if (typeof modificarSeleccion === "function") {
														modificarSeleccion(ent, "añadir");
												}
										}
								}

								const pathname = window.location.pathname.replace(/\/$/, "");
								const href = window.location.href;

								const esSinTelefono = href.includes("internet-sin-telefono") || pathname.endsWith("internet-sin-telefono");
								const tipoContratacion = esSinTelefono ? "SOLO_INTERNET" : "PAQUETE";

								const urlParams = new URLSearchParams(window.location.search);
								const codigoEnt = urlParams.get("ent") || null;

								cambiaSeleccion(tipoContratacion, codigoEnt);
						}
        </script>
           <script>
    document.addEventListener("DOMContentLoaded", function() {
        if(!window.location.pathname.startsWith("/web/hogar/home_sb_h")) return;
        try {
          var anchors = document.querySelectorAll('a[href^="/web/contrata/lineas-nuevas"]');

          anchors.forEach(function(anchor) {
            var currentHref = anchor.getAttribute('href');
            if (currentHref) {
              var newHref = currentHref.replace('/web/contrata/lineas-nuevas', '/web/contrata/lineas-nuevas-beta');
              anchor.setAttribute('href', newHref);
            }
          });

          console.log('Se actualizaron ' + anchors.length + ' enlaces a la versión beta.');
          //sessionStorage.setItem("ub", '{"lat":19.435016,"lng":-99.1679844}')
        } catch (e) {
          console.error('Error en GTM actualizando URLs:', e);
        }
    });
</script>
