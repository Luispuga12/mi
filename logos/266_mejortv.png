         <script>
    // Carga diferida e inicialización de Watson
    let watsonCargado = false;
    const eventosCriticosWatson = ['mouseover', 'keydown', 'touchstart', 'wheel'];

    function cargarWatson() {
        if (watsonCargado) return;
        watsonCargado = true;

        eventosCriticosWatson.forEach(evento => {
            window.removeEventListener(evento, cargarWatson);
        });

        const scriptWatson = 'https://chat.telmex.com/watson-user-interface/public/chat-telmex/js/functions-ui.min.js';

        const script = document.createElement('script');
        script.async = true;
        script.src = scriptWatson;
        script.onload = () => {
            if (typeof chatWatson === 'undefined' || !chatWatson) {
                if (typeof configWatson !== 'undefined') {
                    chatWatson = new UiChat(configWatson);
                }
            }
        };
        script.onerror = (err) => console.error("Error al cargar script de Watson:", err);

        document.head.appendChild(script);
    }

    eventosCriticosWatson.forEach(evento => {
        window.addEventListener(evento, cargarWatson, { passive: true });
    });

    //Funciones para Watson
    const mapTemasWatsonPorPaso = {
        hogar: {
            0: "residencial_datosContacto",
            1: "residencial_ubicacion",
            2: "residencial_oferta",
            3: "residencial_oferta",
            4: "residencial_oferta",
            5: "residencial_comprobante"
        },
        negocio: {
            0: "comercial_datos",
            1: "comercial_domicilio",
            2: "comercial_oferta",
            3: "residencial_oferta",
            4: "residencial_oferta",
            5: "comercial_comprobante"
        }
    }

    async function handlerWatson() {
        const { os_name, browser, browser_version } = obtenerInfoDispositivo();
        
        // Asignación segura en caso de que dts o dts.paquete no estén definidos al cargar
        let mercado = "hogar";
        if (typeof dts !== 'undefined' && dts.paquete && dts.paquete.mercado) {
            mercado = dts.paquete.mercado;
        }

        let ip = "127.0.0.1";
        try {
            ip = await obtenerIp();
        } catch (e) {
            console.warn("No se pudo obtener la IP para Watson");
        }

        let namD = cookieValida('_nam') ? encok(getCookie('_nam'), 'd') : "";
        let telD = cookieValida('_tel') ? encok(getCookie('_tel'), 'd') : "";
        let prvD = cookieValida('_pvci') ? encok(getCookie('_pvci'), 'd') : null;
        let prvAD = cookieValida('prv_a') ? encok(getCookie('_pvcia'), 'd') : null;

        // Verificar el paso actual, default 0
        let pasoWatson = (typeof pasoActual !== 'undefined') ? pasoActual : 0;

        let security_context = {
            telefono: telD,
            nombre: namD,
            tema_ayuda: mapTemasWatsonPorPaso[mercado] ? mapTemasWatsonPorPaso[mercado][pasoWatson] : "",
            tema_select: "",
            session_id_interact: "12D46D367B6B42898C94B37AA796DCEE",
            start_conversation: "0",
            os_name,
            browser,
            browser_version,
            ip
        };

        if (prvD) security_context.prv = prvD;
        if (prvAD) security_context.prv_a = prvAD;

        return {
            question_user: "",
            security_context: security_context,
            communication_context: {
                channel: {
                    channel_type: "telmexcom",
                    client_profile: mercado == "hogar" ? "residencial" : "comercial"
                },
                tema_url: "https://telmex.com/web/contrata/lineas-nuevas",
                nombre_form: "",
                nombre_campo_form: "",
                campos_form: [
                    {
                        nombre_campo: "ultimo_campo_visitado",
                        valor_campo: ""
                    }
                ]
            }
        };
    }

    document.addEventListener("DOMContentLoaded", function () {
        const TIEMPO_NOTIFICACION_MS = 6000;  // Tiempo para mostrar el número 1 rojo
        const TIEMPO_MENSAJE_MS = 1200000000; // Tiempo para mostrar la burbuja de diálogo/teaser
        const TIEMPO_DESVANECER_MS = 60000; // 1 minuto para desvanecer el teaser

        const indicadorNotificacion = document.getElementById("watson-bubble-badge");
        const mensajeFlotante = document.getElementById("watson-teaser-popup");
        const botonCerrarDialogo = document.getElementById("watson-teaser-close");
        const botonNo = document.getElementById("watson-btn-no");
        const botonAyuda = document.getElementById("watson-btn-ayuda");
        const botonBurbuja = document.getElementById("watson-bubble-button");
        const contenedorBurbuja = document.getElementById("watson-chat-bubble-container");
        const carritoMobile = document.getElementById("carritoMobile");

        let temporizadorNotificacion;
        let temporizadorMensaje;
        let temporizadorDesvanecer;

        function acomodarBurbujaSobreCarrito() {
            let bottomOffset = 24;

            if (carritoMobile && (carritoMobile.offsetWidth > 0 || carritoMobile.offsetHeight > 0)) {
                bottomOffset = Math.max(bottomOffset, carritoMobile.offsetHeight + 5);
            }

            const ctaWrapper = document.querySelector('.cta-atencion-wrapper');
            if (ctaWrapper && (ctaWrapper.offsetWidth > 0 || ctaWrapper.offsetHeight > 0)) {
                bottomOffset = Math.max(bottomOffset, ctaWrapper.offsetHeight + 5);
            }

            if (contenedorBurbuja) contenedorBurbuja.style.bottom = bottomOffset + "px";
        }

        // Acomodar al inicio y en caso de redimensionar la pantalla
        acomodarBurbujaSobreCarrito();
        window.addEventListener("resize", acomodarBurbujaSobreCarrito);

        temporizadorNotificacion = setTimeout(function () {
            if (indicadorNotificacion) indicadorNotificacion.style.display = "flex";
        }, TIEMPO_NOTIFICACION_MS);

        temporizadorMensaje = setTimeout(function () {
            if (mensajeFlotante && window.location.pathname == "/web/contrata/lineas-nuevas") mensajeFlotante.classList.add("active");
        }, TIEMPO_MENSAJE_MS);

        function desvanecerMensaje() {
            if (mensajeFlotante) {
                mensajeFlotante.style.transition = "opacity 0.4s ease";
                mensajeFlotante.style.opacity = "0";
                setTimeout(() => {
                    mensajeFlotante.classList.remove("active");
                    mensajeFlotante.style.display = "";
                    mensajeFlotante.style.opacity = "";
                }, 400);
            }
        }

        temporizadorDesvanecer = setTimeout(function () {
            desvanecerMensaje();
        }, TIEMPO_DESVANECER_MS);

        function limpiarTemporizadores() {
            clearTimeout(temporizadorNotificacion);
            clearTimeout(temporizadorMensaje);
            clearTimeout(temporizadorDesvanecer);
        }

        async function abrirWatsonChat() {
            acomodarBurbujaSobreCarrito();
            limpiarTemporizadores();
            if (mensajeFlotante) {
                mensajeFlotante.classList.remove("active");
                mensajeFlotante.style.display = "none";
            }
            if (indicadorNotificacion) indicadorNotificacion.style.display = "none";

            if (typeof chatWatson === "undefined" || !chatWatson) {
                const event = new MouseEvent('mouseover', {
                    view: window,
                    bubbles: true,
                    cancelable: true
                });
                window.dispatchEvent(event);
            }

            let intentos = 0;
            const checkWatson = setInterval(async () => {
                intentos++;
                if (typeof chatWatson !== "undefined" && chatWatson) {
                    clearInterval(checkWatson);
                    try {
                        const context = await handlerWatson();
                        chatWatson.startChat(context);
                    } catch (e) {
                        console.error("Error al iniciar Watson:", e);
                    }
                }
                if (intentos > 20) {
                    clearInterval(checkWatson);
                    console.error("Timeout cargando Watson.");
                }
            }, 500);
        }

        // Eventos
        if (botonBurbuja) {
            botonBurbuja.addEventListener("click", abrirWatsonChat);
        }
        if (botonAyuda) {
            botonAyuda.addEventListener("click", abrirWatsonChat);
        }

        function cerrarMensajeFlotante() {
            desvanecerMensaje();
        }

        if (botonCerrarDialogo) {
            botonCerrarDialogo.addEventListener("click", cerrarMensajeFlotante);
        }
        if (botonNo) {
            botonNo.addEventListener("click", cerrarMensajeFlotante);
        }
    });

    

    

    function obtenerInfoDispositivo() {
        const ua = navigator.userAgent;
        let os_name = "Unknown OS";
        let browser = "Unknown Browser";
        let browser_version = "Unknown Version";

        if (ua.indexOf("Win") !== -1) os_name = "Windows";
        else if (ua.indexOf("Mac") !== -1) os_name = "MacOS";
        else if (ua.indexOf("X11") !== -1) os_name = "UNIX";
        else if (ua.indexOf("Linux") !== -1) os_name = "Linux";
        else if (/Android/.test(ua)) os_name = "Android";
        else if (/iPhone|iPad|iPod/.test(ua)) os_name = "iOS";

        if (ua.indexOf("Firefox") !== -1) {
            browser = "Firefox";
            const match = ua.match(/Firefox\/([0-9.]+)/);
            if (match) browser_version = match[1];
        } else if (ua.indexOf("SamsungBrowser") !== -1) {
            browser = "Samsung Browser";
            const match = ua.match(/SamsungBrowser\/([0-9.]+)/);
            if (match) browser_version = match[1];
        } else if (ua.indexOf("Opera") !== -1 || ua.indexOf("OPR") !== -1) {
            browser = "Opera";
            const match = ua.match(/(?:Opera|OPR)\/([0-9.]+)/);
            if (match) browser_version = match[1];
        } else if (ua.indexOf("Edge") !== -1 || ua.indexOf("Edg") !== -1) {
            browser = "Edge";
            const match = ua.match(/(?:Edge|Edg)\/([0-9.]+)/);
            if (match) browser_version = match[1];
        } else if (ua.indexOf("Chrome") !== -1) {
            browser = "Chrome";
            const match = ua.match(/Chrome\/([0-9.]+)/);
            if (match) browser_version = match[1];
        } else if (ua.indexOf("Safari") !== -1) {
            browser = "Safari";
            const match = ua.match(/Version\/([0-9.]+)/);
            if (match) browser_version = match[1];
        }

        return { os_name, browser, browser_version };
    }

    async function obtenerIp() {
        let ipAddress = "201.116.244.182";
        try {
            const response = await fetch("https://apcomercial.telmex.com/dev/checaip.php", {
                "method": "POST",
            });
            const data = await response.json();
            if (data && data.key1) {
                ipAddress = data.key1;
            }
        } catch (e) {
            console.error("Error al obtener la IP para Watson:", e);
        }

        return ipAddress
    }

    // Ajuste de margen inferior para cta-atencion-wrapper
    function adjustFooterMargin() {
        const ctaWrapper = document.querySelector('.cta-atencion-wrapper');
        const footerContainer = document.querySelector('.bottom-footer-container');
        
        if (ctaWrapper && footerContainer) {
            const height = ctaWrapper.offsetHeight;
            footerContainer.style.marginBottom = height + 'px';
        }
    }

    // Función utilitaria para ejecutar código cuando el DOM esté listo o si ya lo está
    function ejecutarAlCargarDOM(callback) {
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', callback);
        } else {
            callback();
        }
    }

    window.addEventListener('load', adjustFooterMargin);
    window.addEventListener('resize', adjustFooterMargin);
    ejecutarAlCargarDOM(adjustFooterMargin);

    ejecutarAlCargarDOM(() => {
        const btnNewsLetter = document.getElementById('newsLetter');
        if (btnNewsLetter) {
            btnNewsLetter.addEventListener('click', async (e) => {
                e.preventDefault();
                
                const mensajeDiv = document.getElementById('mensaje');
                const msgSuscr = document.getElementById('msgSuscr');
                const inputCorreo = document.getElementById('correoNewsLetter');
                
                if (mensajeDiv) mensajeDiv.innerHTML = '';
                if (msgSuscr) msgSuscr.innerHTML = '';
                
                const testEmail = /^[A-Z0-9._%+-]+@([A-Z0-9-]+\.)+[A-Z]{2,4}$/i;
                const news = inputCorreo ? inputCorreo.value.trim() : '';
                
                if (testEmail.test(news)) {
                    // Se remueve la variable de Freemarker y se deja una ruta de ejemplo
                    const url = '/bin/registro-newsletter';
                    
                    try {
                        const response = await fetch(url, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                            },
                            body: 'correo=' + encodeURIComponent(news)
                        });
                        
                        if (mensajeDiv) {
                            mensajeDiv.innerHTML = '<h3>¡Gracias por registrarte con nosotros! En breve recibiras nuevas noticias y promociones.</h3>';
                            mensajeDiv.style.display = 'block';
                        }
                        
                        const newsLetterContainer = document.querySelector('.newsLetter');
                        if (newsLetterContainer) {
                            newsLetterContainer.style.display = 'none';
                        }
                    } catch (error) {
                        console.error('Error al registrar newsletter:', error);
                    }
                }
            });
        }
    });
</script>
        </div>
       </div>
      </div>
     </div>
    </div>
   </section>
  </div>
 </div>
