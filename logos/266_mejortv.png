               <div id="div_contrata_exito" style="color: #008000; font-size: 20px; font-weight: bold; min-height: 400px; position: relative;" class="text-center"><img style="max-width: 70px; margin-bottom: 30px;" src="/documents/d/contrata/ok-1" alt="">
                <p>Tus datos fueron enviados con éxito</p>
                <div class="modal-hgr-btn-primary mt-3" style="position: absolute; bottom: 0; width: 100%;"><a id="btn-domi-aceptar" class="w-100" href="#" target="_self"> Aceptar </a>
                </div>
               </div>
