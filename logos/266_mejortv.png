    /* estilos del tootip */
    .tooltip-container {
        position: absolute;
        display: inline-block;
    }

    .tooltip-btn {
        background-color: #000000;
        color: white;
        border: none;
        font-size: 10px !important;
        padding: 0px 8px;
        border-radius: 50%;
        right: -14px;
        position: relative;
    }

    .tooltip-text {
        position: absolute;
        background: #000000;
        color: white;
        padding: 8px 12px;
        border-radius: 5px;
        font-size: 11px;
        bottom: -140%;
        left: 0%;
        transform: translateX(-90%);
        visibility: hidden;
        opacity: 0;
        transition: opacity 0.3s ease-in-out;
        width: 165px;
    }

    .tooltip-container:hover .tooltip-text {
        visibility: visible;
        opacity: 1;
    }

    /*******************  MEDIAQUERIES ***********************************/


    /* estilos de los paquetes */
    /* mediaQuery para alinear contenidos bottom en carrusel */

    @media screen and (max-width: 1320px) {
        .aui .wrapperServInternet .slick-track {
            display: flex;
            align-items: baseline;
        }
    }

    @media (max-width: 600px) {

        #wrapper .flex_cont {
            flex-flow: column wrap;
            width: 90%;
            margin: auto;
        }

        #wrapper .bloq_izq_prom_blue,
        .bloq_der_prom_doble {
            width: 100%;
            max-width: none;
            margin: 10px auto;
        }

        #wrapper h1.tit_azul_c,
        #wrapper h1.tit_azul_c span {
            font-size: 32px;
        }

        .container_divs_c {
            margin: 10px auto 30px;
        }

        .telefonia_internet_c,
        .solo_internet_c {
            border-radius: 30px;
            width: 272px;
            margin: 6.5px auto;
        }

        .ver_paquetes_c a,
        .ver_paquetes_c button,
        .ver_paquetes_c div {
            background: #de2f1b;
            color: #fff !important;
        }

        .incluye_c,
        .icon2_c,
        .icon1_c,
        .icon3_c {
            display: none !important;
        }

        .nota_pie_c {
            margin: 50px auto 20px auto;
        }

        .todo_listado_c {
            margin: 11px 0px 0 0;
        }

        .tit_sub_blue {
            font-size: 14px;
        }
    }



    /* ESTILOS NUEVOS PARA LA TARJETA (NUEVO DISEÑO) */
    .tarjeta_paq_c {
        border-radius: 12px;
        background: #fff;
        border: 1px solid #17B9FD;
        padding: 10px 10px;
        text-align: center;
        position: relative;
        font-family: 'Roboto', sans-serif;
        width: 275px;
        max-width: 275px;
        float: left;
        margin: 8px 8px;
    }

    .promo_legal {
        font-size: 10px;
        color: #7B7B7B;
        text-align: center;
        margin-top: 10px;
        line-height: 1.2;
    }

    .selec-group {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
    }

    .custom-checkbox {
        display: flex;
        align-items: center;
        cursor: pointer;
        position: relative;
        padding-left: 30px;
        font-size: 14px;
        margin-bottom: 0;
        height: 45px;
    }

    .custom-checkbox input {
        position: absolute;
        opacity: 0;
        cursor: pointer;
    }

    .checkmark {
        position: absolute;
        left: 0;
        height: 20px;
        width: 20px;
        border: 2px solid #0067ee;
        border-radius: 4px;
        background-color: transparent;
    }

    .custom-checkbox input:checked~.checkmark {
        background-color: #0067ee;
        border-color: #0067ee;
    }

    .checkmark:after {
        content: "";
        position: absolute;
        display: none;
        left: 5px;
        top: 1px;
        width: 6px;
        height: 12px;
        border: solid white;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
    }

    .custom-checkbox input:checked~.checkmark:after {
        display: block;
    }

    img.prom_logo_netflix {
